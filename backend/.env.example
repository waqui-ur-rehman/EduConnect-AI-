# EduConnect AI — environment template. Copy to .env and fill in. NEVER commit real secrets.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/educonnect_ai
JWT_SECRET=replace-with-a-random-32-plus-byte-secret
CLIENT_ORIGIN=http://localhost:5173
SESSION_HOURS=12

# ---------------------------------------------------------------- payments
# Mode: sandbox (default) or live. Live additionally requires PAYMENTS_LIVE_ENABLED=true,
# complete provider credentials, the provider's checkout URL and the provider's
# *_INTEGRATION_VERIFIED=true flag (set only after a passing sandbox end-to-end run).
PAYMENT_MODE=sandbox
PAYMENTS_LIVE_ENABLED=false
MARKETPLACE_CURRENCY=PKR
PLATFORM_COMMISSION_RATE=0.2
FRONTEND_PUBLIC_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:5000

# Demo/test checkout (development only, never in production).
PAYMENT_DEMO_CHECKOUT=false

# HMAC secret used by the built-in signature verification (and the test adapter).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PAYMENT_WEBHOOK_SECRET=

# JazzCash — HOSTED page. UNVERIFIED: confirm endpoint/field set/hash against the
# JazzCash merchant integration guide before live use. Sandbox default shown.
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_CHECKOUT_URL=https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/
# Optional overrides: JAZZCASH_PP_VERSION=1.1 JAZZCASH_TXN_TYPE=MPAY JAZZCASH_SUCCESS_CODES=000
# Enable the authoritative status poll only with the endpoint confirmed in the docs:
# JAZZCASH_QUERY_URL=
JAZZCASH_INTEGRATION_VERIFIED=false

# Easypaisa — HOSTED page (eServices). UNVERIFIED: confirm store hash algorithm,
# fields and callback format against Easypaisa merchant documentation before live use.
EASYPAISA_STORE_ID=
EASYPAISA_MERCHANT_CREDENTIALS=
EASYPAISA_CHECKOUT_URL=https://easypaystg.easypaisa.com.pk/easypay/Index.jsf
# Optional overrides: EASYPAISA_PAYMENT_TYPE=MA EASYPAISA_NOTIFY_EMAIL= EASYPAISA_SUCCESS_CODES=0000
EASYPAISA_INTEGRATION_VERIFIED=false

# Safepay — JSON API + hosted checkout + HMAC-signed webhook. UNVERIFIED: confirm
# session-create path, webhook signature header and payload schema against
# developer.safepay.io before live use.
SAFEPAY_API_KEY=
SAFEPAY_API_SECRET=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_API_BASE_URL=https://sandbox.api.safepay.io
# No fabricated default: required for checkout to start. Set only the official endpoint:
# SAFEPAY_CHECKOUT_URL=
# SAFEPAY_STATUS_URL=
# SAFEPAY_WEBHOOK_SIGNATURE_HEADER=x-safepay-signature
SAFEPAY_INTEGRATION_VERIFIED=false

# --- going live (all required) ---
# 1) Complete a full sandbox purchase with each provider and confirm callbacks/webhooks.
# 2) Set <PROVIDER>_INTEGRATION_VERIFIED=true. 3) Set PAYMENT_MODE=live.
# 4) Set PAYMENTS_LIVE_ENABLED=true. 5) Set live endpoints where no default exists.
# 6) Ensure CLIENT_ORIGIN uses public HTTPS and callbacks are reachable from the internet.

# ---------------------------------------------------------------- realtime notifications
# Optional. Enables cross-instance SSE notification delivery via Redis pub/sub.
# Leave empty for single-instance/local development (in-process bus is used).
# REDIS_URL=redis://127.0.0.1:6379
# For production multi-instance: point all backend instances at the same Redis.
# Redis is NOT required; if unavailable, the app falls back to single-instance delivery.
